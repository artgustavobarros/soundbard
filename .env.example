# Credenciais locais de desenvolvimento; o banco escuta somente no próprio computador.
DATABASE_URL=postgresql://soundbard:soundbard@127.0.0.1:55439/soundbard
# Áudios persistentes por SHA-256; mantenha este diretório fora do Git e inclua-o no backup.
SOUNDBARD_DATA_DIR=.data


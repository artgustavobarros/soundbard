{
  "name": "soundbard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && node scripts/offline.ts",
    "check": "pnpm lint && pnpm lint:backend && pnpm typecheck && pnpm test && pnpm test:backend && pnpm build",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "generate-routes": "tsr generate",
    "lint": "ultracite check",
    "lint:backend": "node scripts/python.ts -m ruff check backend scripts/e2e-database.py && node scripts/python.ts -m ruff format --check backend scripts/e2e-database.py",
    "lint:fix": "ultracite fix",
    "preview": "pnpm start",
    "start": "node --env-file-if-exists=.env scripts/python.ts -m backend",
    "test": "vitest run",
    "test:backend": "node scripts/python.ts -m pytest",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/roboto": "5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.56.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "6.2.7",
    "typescript": "^6.0.2",
    "ultracite": "^8.1.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  }
}
